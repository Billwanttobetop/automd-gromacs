; Energy Minimization
; Use: gmx grompp -f em.mdp -c system.gro -p topol.top -o em.tpr
integrator              = steep
emtol                   = 1000.0
emstep                  = 0.01
nsteps                  = 50000

nstlist                 = 1
cutoff-scheme           = Verlet
ns_type                 = grid
pbc                     = xyz
coulombtype             = PME
rcoulomb                = 1.0
rvdw                    = 1.0
fourierspacing          = 0.12
DispCorr                = no
